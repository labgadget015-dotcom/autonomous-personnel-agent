# ============================================================
# Autonomous Personnel Agent — Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ---- REQUIRED -----------------------------------------------

# OpenAI API key (get one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-...

# API auth token — used by n8n → FastAPI and dashboard → FastAPI
# Generate with: openssl rand -hex 32
API_TOKEN=change-me-to-a-long-random-string

# Postgres password
POSTGRES_PASSWORD=change-me-strong-password

# n8n admin password
N8N_BASIC_AUTH_PASSWORD=change-me-n8n-password

# ---- OPTIONAL (sensible defaults shown) ---------------------

# LLM models
ORCHESTRATOR_MODEL=gpt-4.1
AGENT_MODEL=gpt-4.1-mini

# Postgres connection
POSTGRES_DB=personnel_agent
POSTGRES_USER=agent
POSTGRES_PORT=5432

# Service ports (change if you have conflicts)
API_PORT=8000
N8N_PORT=5678
DASHBOARD_PORT=3000

# n8n settings
N8N_BASIC_AUTH_USER=admin
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

# Slack (optional — for approval notifications)
SLACK_APPROVAL_CHANNEL=#hr-approvals
SLACK_LEGAL_CHANNEL=#legal-urgent

# Timezone
TZ=Europe/London

# Runtime
ENV=production

# ---- OpenTelemetry ----
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=autonomous-personnel-agent

# ---- Redis (arq job queue + rate limiting) ----
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ---- Rate limiting ----
RATE_LIMIT_AGENT=20/minute
RATE_LIMIT_DEFAULT=60/minute

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Self-Refining Agent System ----
SELF_EVAL_ENABLED=false
PROMPT_REFINE_ENABLED=false
AB_TEST_SPLIT=10
REFINE_MIN_FAILURES=3
EVAL_JUDGE_MODEL=gpt-4.1-mini
REFINE_MODEL=gpt-4.1

# ---- Budget + Pass-Rate Alerts ----
# Daily LLM spend limit in USD before webhook alert fires
DAILY_COST_BUDGET_USD=5.00
# Minimum 24h pass rate (%) before per-agent webhook alert fires
MIN_PASS_RATE_ALERT=70
