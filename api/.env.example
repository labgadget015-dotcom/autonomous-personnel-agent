# ============================================================
# Autonomous Personnel Agent — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# OpenAI
OPENAI_API_KEY=sk-...

# Agent Models
ORCHESTRATOR_MODEL=gpt-4.1
AGENT_MODEL=gpt-4.1-mini

# API Security
API_TOKEN=change-me-to-a-long-random-string

# Server
PORT=8000
ENV=production

# Postgres (for audit log, people DB)
DATABASE_URL=postgresql://user:password@localhost:5432/personnel_agent

# Knowledge base vectorstore path (optional)
KNOWLEDGE_VECTORSTORE_PATH=./knowledge_index

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# n8n Webhook URL (for approval callbacks)
N8N_WEBHOOK_BASE=http://localhost:5678/webhook

# Slack (optional — for approval notifications)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APPROVAL_CHANNEL=#hr-approvals

# Gmail / Email (optional — for outreach sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=app-password-here
